// Schema multi-tenant — ver ARCHITECTURE.md § "Padrões obrigatórios para queries multi-tenant"
// para os 5 padrões que DEVEM ser seguidos em todo código novo que acessa o banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROFISSIONAL
  RECEPCAO
}

enum TipoVinculo {
  COMISSIONADO
  LOCATARIO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  REALIZADO
  CANCELADO
  FALTOU
}

enum OrigemAgendamento {
  PUBLICO
  INTERNO
}

enum TipoFinanceiro {
  RECEITA
  DESPESA
  INVESTIMENTO
}

enum StatusFinanceiro {
  PENDENTE
  PAGO
}

enum PlanoTenant {
  BASICO
  PROFISSIONAL
  ENTERPRISE
}

enum StatusTenant {
  TRIAL
  ATIVO
  BLOQUEADO
  CANCELADO
}

model Tenant {
  id                  String       @id @default(cuid())
  slug                String       @unique
  nome                String
  plano               PlanoTenant  @default(BASICO)
  status              StatusTenant @default(TRIAL)
  trialEndsAt         DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users                 User[]
  profissionais         Profissional[]
  pacientes             Paciente[]
  salas                 Sala[]
  disponibilidades      Disponibilidade[]
  bloqueios             Bloqueio[]
  agendamentos          Agendamento[]
  categoriasFinanceiras CategoriaFinanceira[]
  transacoes            TransacaoFinanceira[]
  comissoes             Comissao[]
  parcelamentos         Parcelamento[]
  servicos              Servico[]
  crmTemplates          CrmTemplate[]
  crmCampanhas          CrmCampanha[]
  taxasImposto          TaxaImposto[]
  despesasProfissional  DespesaProfissional[]
  alugueis              Aluguel[]
  configClinica         ConfigClinica[]
}

model User {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name               String
  email              String
  passwordHash       String
  role               Role      @default(RECEPCAO)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profissional Profissional?

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([resetToken])
}

model Profissional {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  especialidade       String
  crp                 String?
  tipoVinculo         TipoVinculo
  comissaoPercentual  Decimal?    @db.Decimal(5, 2)
  valorAluguelMensal  Decimal?    @db.Decimal(10, 2)
  mesesContrato       Int?
  // TODO: migrar para URL externa em fase de storage
  fotoBase64          String?
  asaasApiKey         String?
  slugAgendamento     String
  valorConsultaPadrao Decimal?    @db.Decimal(10, 2)
  bio                 String?
  ativo               Boolean     @default(true)
  createdAt           DateTime    @default(now())

  disponibilidades Disponibilidade[]
  bloqueios        Bloqueio[]
  agendamentos     Agendamento[]
  comissoes        Comissao[]
  alugueis         Aluguel[]
  transacoes       TransacaoFinanceira[]
  despesas         DespesaProfissional[]
  parcelamentos    Parcelamento[]

  @@unique([slugAgendamento, tenantId])
  @@index([tenantId])
  @@index([slugAgendamento])
}

model Paciente {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nome           String
  cpf            String?
  telefone       String?
  email          String?
  dataNascimento DateTime?
  genero         String?
  endereco       String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  cep            String?
  observacoes    String?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())

  agendamentos Agendamento[]

  @@unique([cpf, tenantId])
  @@index([tenantId])
  @@index([cpf])
  @@index([nome])
}

model Sala {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nome       String
  capacidade Int      @default(1)
  descricao  String?
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())

  agendamentos Agendamento[]

  @@unique([nome, tenantId])
  @@index([tenantId])
}

model Disponibilidade {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  diaSemana      Int
  horaInicio     String
  horaFim        String

  @@index([tenantId])
  @@index([profissionalId])
}

model Bloqueio {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  dataHoraInicio DateTime
  dataHoraFim    DateTime
  motivo         String?

  @@index([tenantId])
  @@index([profissionalId])
}

model Agendamento {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId     String
  profissional       Profissional      @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  pacienteId         String
  paciente           Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  salaId             String
  sala               Sala              @relation(fields: [salaId], references: [id], onDelete: Restrict)
  dataHoraInicio     DateTime
  dataHoraFim        DateTime
  status             StatusAgendamento @default(AGENDADO)
  valor              Decimal           @db.Decimal(10, 2)
  tipoCobranca       String            @default("CONSULTA")
  totalSessoes       Int?
  formaPagamento     String?
  bandeiraCartao     String?
  numeroParcelas     Int?              @default(1)
  taxaCartaoPerc     Decimal?          @db.Decimal(5, 2)
  confirmacaoEnviada Boolean           @default(false)
  lembreteEnviado    Boolean           @default(false)
  asaasPaymentId     String?
  asaasInvoiceUrl    String?
  asaasPaymentStatus String?
  origem             OrigemAgendamento @default(INTERNO)
  observacoes        String?
  recorrenciaGrupoId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  comissao      Comissao?
  transacoes    TransacaoFinanceira[]
  parcelamentos Parcelamento[]
  servicos      AgendamentoServico[]

  @@index([tenantId])
  @@index([dataHoraInicio])
  @@index([profissionalId])
  @@index([recorrenciaGrupoId])
  @@index([pacienteId])
  @@index([salaId])
}

model CategoriaFinanceira {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nome     String
  tipo     TipoFinanceiro
  cor      String

  transacoes TransacaoFinanceira[]

  @@index([tenantId])
}

model TransacaoFinanceira {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tipo           TipoFinanceiro
  categoriaId    String
  categoria      CategoriaFinanceira @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  descricao      String
  valor          Decimal             @db.Decimal(10, 2)
  data           DateTime
  formaPagamento String?
  status         StatusFinanceiro    @default(PENDENTE)
  dataPagamento  DateTime?
  profissionalId String?
  profissional   Profissional?       @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  agendamentoId  String?
  agendamento    Agendamento?        @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  observacoes    String?
  createdAt      DateTime            @default(now())

  @@index([tenantId])
  @@index([data])
  @@index([tipo])
  @@index([profissionalId])
}

model Comissao {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId String
  profissional   Profissional     @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  agendamentoId  String           @unique
  agendamento    Agendamento      @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  valorBruto     Decimal          @db.Decimal(10, 2)
  percentual     Decimal          @db.Decimal(5, 2)
  valorComissao  Decimal          @db.Decimal(10, 2)
  valorClinica   Decimal          @db.Decimal(10, 2)
  status         StatusFinanceiro @default(PENDENTE)
  formaPagamento String?
  dataPagamento  DateTime?
  observacao     String?

  @@index([tenantId])
  @@index([profissionalId])
}

model Parcelamento {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  agendamentoId  String?
  agendamento    Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  descricao      String
  valorTotal     Decimal      @db.Decimal(10, 2)
  bandeira       String
  tipoPagamento  String
  taxaCartao     Decimal      @db.Decimal(5, 2) @default(0)
  totalParcelas  Int
  valorLiquido   Decimal      @db.Decimal(10, 2)
  status         String       @default("ATIVO")
  createdAt      DateTime     @default(now())

  parcelas Parcela[]

  @@index([tenantId])
  @@index([profissionalId])
}

// NOTE: tabela sem tenantId direto. Isolamento garantido via Parcelamento.tenantId.
// Toda query precisa filtrar explicitamente via where: { parcelamento: { tenantId } }.
model Parcela {
  id             String       @id @default(cuid())
  parcelamentoId String
  parcelamento   Parcelamento @relation(fields: [parcelamentoId], references: [id], onDelete: Cascade)
  numero         Int
  dataVencimento DateTime     @db.Date
  valor          Decimal      @db.Decimal(10, 2)
  status         String       @default("PENDENTE")
  dataPagamento  DateTime?

  @@index([parcelamentoId])
  @@index([dataVencimento])
}

// TODO: migrar para Tenant e remover em fase futura
model ConfigClinica {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nome        String   @default("Clínica de Psicologia")
  // TODO: migrar para URL externa em fase de storage
  logoBase64  String?
  corPrimaria String   @default("#4f46e5")
  cnpj        String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  telefone    String?
  email       String?
  lat         Float?
  lng         Float?
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Servico {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  agendamentos AgendamentoServico[]

  @@unique([nome, tenantId])
  @@index([tenantId])
}

model AgendamentoServico {
  agendamentoId String
  servicoId     String
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servico       Servico     @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@id([agendamentoId, servicoId])
  @@index([servicoId])
}

model CrmTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  titulo    String
  canal     String   // WHATSAPP | EMAIL
  assunto   String?
  corpo     String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model CrmCampanha {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  titulo       String
  canal        String   // WHATSAPP | EMAIL
  mensagem     String
  assunto      String?
  filtros      String?  // JSON com filtros aplicados
  status       String   @default("RASCUNHO")
  totalEnviado Int      @default(0)
  criadaEm     DateTime @default(now())

  @@index([tenantId])
}

model TaxaImposto {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nome      String
  tipo      String   // MUNICIPAL | FEDERAL | ESTADUAL
  aliquota  Decimal? @db.Decimal(5, 2)
  valorFixo Decimal? @db.Decimal(10, 2)
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tipo])
}

model DespesaProfissional {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId String
  profissional   Profissional     @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  descricao      String
  valor          Decimal          @db.Decimal(10, 2)
  data           DateTime         @db.Date
  categoria      String
  status         StatusFinanceiro @default(PENDENTE)
  formaPagamento String?
  dataPagamento  DateTime?
  observacao     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([profissionalId])
  @@index([data])
}

model Aluguel {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profissionalId String
  profissional   Profissional     @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  mesReferencia  DateTime         @db.Date
  valor          Decimal          @db.Decimal(10, 2)
  status         StatusFinanceiro @default(PENDENTE)
  formaPagamento String?
  dataPagamento  DateTime?
  observacao     String?

  @@index([tenantId])
  @@index([profissionalId])
  @@index([mesReferencia])
}
